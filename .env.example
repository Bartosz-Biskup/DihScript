# Copy this file to .env and fill in real values. .env is gitignored.

# LiteLLM model used by the LLM service.
LLM_MODEL=openai/gpt-4o-mini

# Directory with prompt templates, relative to the app working directory.
PROMPTS_DIR=prompts

# MySQL database name and root password. docker-compose reads these to
# create the database; keep them in sync with DATABASE_URL below.
DATABASE_NAME=tiktok_analysis
DATABASE_PASSWORD=change-me

# Local development URL: MySQL is exposed on host port 3307 by docker-compose.
# Inside the app container, docker-compose overrides this to
# mysql+pymysql://root:${DATABASE_PASSWORD}@database:3306/${DATABASE_NAME}
# (the "database" hostname only exists on the compose network).
# To run without MySQL entirely, use: sqlite:///./app.db
DATABASE_URL=mysql+pymysql://root:change-me@127.0.0.1:3307/tiktok_analysis

# Comma-separated list of allowed browser origins for CORS.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
